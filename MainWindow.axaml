<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AIUsage"
        x:Class="AIUsage.MainWindow"
        x:DataType="local:UsageCoordinator"
        Width="270" SizeToContent="Height" MinHeight="150"
        WindowDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        Icon="/Assets/app-icon.png" Topmost="True" ShowInTaskbar="False"
        PointerPressed="DragWindow">
  <Window.Resources>
    <local:StateColorConverter x:Key="StateColor"/>
    <local:CompactWindowsConverter x:Key="CompactWindows"/>
    <local:ProviderShortNameConverter x:Key="ProviderShortName"/>
    <local:ResetTimeConverter x:Key="ResetTime"/>
  </Window.Resources>
  <Grid>
  <Border x:Name="FullView" Background="{StaticResource BackgroundBrush}" BorderBrush="#303038" BorderThickness="1" CornerRadius="8" Padding="12">
    <Grid RowDefinitions="Auto,*">
      <TextBlock Text="• AI USAGE" FontSize="12" Foreground="#8D8D98" Margin="0,0,0,10"/>
      <Button Content="×" Click="HideClick" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Foreground="#777780" FontSize="16" Width="20" Height="20" Padding="0" ToolTip.Tip="Ocultar en bandeja"/>
      <StackPanel Grid.Row="1">
        <ItemsControl ItemsSource="{Binding Snapshots}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:UsageSnapshot">
          <StackPanel Margin="0,0,0,11"><DockPanel><TextBlock Text="●" Foreground="{Binding State, Converter={StaticResource StateColor}}" Margin="0,0,5,0"/><TextBlock Text="{Binding Provider}" FontSize="13"/></DockPanel>
          <TextBlock Text="{Binding Message}" FontSize="9" Foreground="#777780" Margin="12,2,0,0" TextWrapping="Wrap" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <ItemsControl ItemsSource="{Binding Windows}" Margin="12,5,0,0"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:QuotaWindow"><Grid ColumnDefinitions="45,*,55" Margin="0,0,0,5"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource MutedBrush}"/><ProgressBar Grid.Column="1" Height="4" Maximum="100" Value="{Binding RemainingPercent}" Background="#3A3A40" Foreground="#A6A6AD" Margin="0,5,8,0"/><TextBlock Grid.Column="2" Text="{Binding RemainingPercent, StringFormat={}{0:0}%}" TextAlignment="Right" FontSize="11" Foreground="#9FAFC4"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
    </Grid>
  </Border>
  <Border x:Name="CompactView" IsVisible="False" Background="#E6101014" BorderBrush="#303038" BorderThickness="1" CornerRadius="7" Padding="7,4" ToolTip.Tip="Vista compacta · menú del icono para desactivar">
    <ItemsControl ItemsSource="{Binding Snapshots}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:UsageSnapshot">
      <Grid Height="18" ColumnDefinitions="10,45,*">
        <TextBlock Text="●" FontSize="8" VerticalAlignment="Center" Foreground="{Binding State, Converter={StaticResource StateColor}}"/>
        <TextBlock Grid.Column="1" Text="{Binding Provider, Converter={StaticResource ProviderShortName}}" FontSize="9" VerticalAlignment="Center" Foreground="#C8C8D0"/>
        <ItemsControl Grid.Column="2" ItemsSource="{Binding Windows, Converter={StaticResource CompactWindows}}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:QuotaWindow">
            <StackPanel Orientation="Horizontal" Margin="0,0,7,0">
              <TextBlock Text="{Binding Label}" FontSize="8" Foreground="#858590" Margin="0,0,3,0"/>
              <TextBlock Text="{Binding RemainingPercent, StringFormat={}{0:0}%}" FontSize="9" Foreground="#9FAFC4"/>
              <TextBlock Text="{Binding ResetsAt, Converter={StaticResource ResetTime}}" FontSize="7" Foreground="#686873" Margin="3,1,0,0" IsVisible="{Binding ResetsAt, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </Border>
  </Grid>
</Window>
