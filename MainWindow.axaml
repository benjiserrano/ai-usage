<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AIUsage"
        x:Class="AIUsage.MainWindow"
        x:DataType="local:UsageCoordinator"
        Width="270" SizeToContent="Height" MinHeight="150"
        CanResize="True" MinWidth="229" MaxWidth="810"
        WindowDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        Icon="/Assets/app-icon.png" Topmost="True" ShowInTaskbar="False"
        PointerPressed="DragWindow" PointerReleased="FinishCompactDrag" PointerWheelChanged="ZoomWheel">
  <Window.Resources>
    <local:StateColorConverter x:Key="StateColor"/>
    <local:CompactWindowsConverter x:Key="CompactWindows"/>
    <local:ProviderShortNameConverter x:Key="ProviderShortName"/>
    <local:ResetTimeConverter x:Key="ResetTime"/>
  </Window.Resources>
  <!-- Cada vista se dibuja sobre un lienzo de 270 puntos y LayoutTransformControl la
       amplía en bloque: tipografía, barras y márgenes crecen con el mismo factor. -->
  <Grid>
  <LayoutTransformControl x:Name="FullView" HorizontalAlignment="Left" VerticalAlignment="Top">
    <Grid Width="270">
      <Border Background="{StaticResource BackgroundBrush}" BorderBrush="#303038" BorderThickness="1" CornerRadius="8" Padding="12">
        <Grid>
          <StackPanel>
            <ItemsControl ItemsSource="{Binding VisibleSnapshots}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:UsageSnapshot">
              <StackPanel Margin="0,0,0,11"><DockPanel><TextBlock Text="●" Foreground="{Binding State, Converter={StaticResource StateColor}}" Margin="0,0,5,0"/><TextBlock Text="{Binding Provider}" FontSize="13"/></DockPanel>
              <TextBlock Text="{Binding Message}" FontSize="9" Foreground="#777780" Margin="12,2,0,0" TextWrapping="Wrap" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <ItemsControl ItemsSource="{Binding Windows}" Margin="12,5,0,0"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:QuotaWindow"><Grid ColumnDefinitions="30,*,40,62" Height="16" Margin="0,0,0,5"><TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><ProgressBar Grid.Column="1" MinWidth="0" MinHeight="0" Height="4" VerticalAlignment="Center" Maximum="100" Value="{Binding RemainingPercent}" Background="#3A3A40" Foreground="#A6A6AD" Margin="10,0,8,0"/><TextBlock Grid.Column="2" Text="{Binding RemainingPercent, StringFormat={}{0:0}%}" TextAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#9FAFC4"/><TextBlock Grid.Column="3" Text="{Binding ResetsAt, Converter={StaticResource ResetTime}}" TextAlignment="Right" VerticalAlignment="Center" FontSize="9" Foreground="#686873" Margin="6,0,0,0" ToolTip.Tip="Fecha de reseteo"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
          <Button Content="&#215;" Click="HideClick" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Foreground="#777780" FontSize="16" Width="24" Height="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Ocultar en bandeja"/>
        </Grid>
      </Border>
      <Border Width="14" Height="14" Margin="0,0,2,2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Background="Transparent" Cursor="SizeWestEast" PointerPressed="StartResize"
              ToolTip.Tip="Arrastra para escalar la ventana (o Ctrl + rueda)">
        <Path Data="M1,11 L11,1 M5,11 L11,5 M9,11 L11,9" Stroke="#55555F" StrokeThickness="1"/>
      </Border>
    </Grid>
  </LayoutTransformControl>
  <LayoutTransformControl x:Name="CompactView" IsVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top">
    <Grid Width="270">
      <Border Background="#E6101014" BorderBrush="#303038" BorderThickness="1" CornerRadius="7" Padding="7,4,12,4" ToolTip.Tip="Vista compacta · menú del icono para desactivar">
        <ItemsControl ItemsSource="{Binding VisibleSnapshots}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:UsageSnapshot">
          <Grid Height="18" ColumnDefinitions="10,45,*">
            <TextBlock Text="●" FontSize="8" VerticalAlignment="Center" Foreground="{Binding State, Converter={StaticResource StateColor}}"/>
            <TextBlock Grid.Column="1" Text="{Binding Provider, Converter={StaticResource ProviderShortName}}" FontSize="9" VerticalAlignment="Center" Foreground="#C8C8D0"/>
            <ItemsControl Grid.Column="2" ItemsSource="{Binding Windows, Converter={StaticResource CompactWindows}}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:QuotaWindow">
                <StackPanel Orientation="Horizontal" Margin="0,0,7,0">
                  <TextBlock Text="{Binding Label}" FontSize="8" Foreground="#858590" Margin="0,0,3,0"/>
                  <TextBlock Text="{Binding RemainingPercent, StringFormat={}{0:0}%}" FontSize="9" Foreground="#9FAFC4"/>
                  <TextBlock Text="{Binding ResetsAt, Converter={StaticResource ResetTime}}" FontSize="7" Foreground="#686873" Margin="3,1,0,0" IsVisible="{Binding ResetsAt, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </Border>
      <Border Width="7" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,1,1,1"
              Background="Transparent" Cursor="SizeWestEast" PointerPressed="StartResize"
              ToolTip.Tip="Arrastra para escalar la ventana (o Ctrl + rueda)">
        <Rectangle Width="1" Height="9" Fill="#55555F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    </Grid>
  </LayoutTransformControl>
  </Grid>
</Window>
