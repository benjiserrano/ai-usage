<Window x:Class="AIUsage.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AIUsage" Width="270" SizeToContent="Height" MinHeight="150" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Icon="Assets/app-icon.ico" Topmost="True" ShowInTaskbar="False" MouseLeftButtonDown="DragWindow">
  <Window.Resources><local:StateColorConverter x:Key="StateColor"/></Window.Resources>
  <Border Background="{StaticResource BackgroundBrush}" BorderBrush="#303038" BorderThickness="1" CornerRadius="8" Padding="12">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <TextBlock Text="• AI USAGE" FontSize="12" Foreground="#8D8D98" Margin="0,0,0,10"/>
      <Button Content="×" Click="HideClick" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Foreground="#777780" FontSize="16" Width="20" Height="20" Padding="0" ToolTip="Ocultar en bandeja"/>
      <StackPanel Grid.Row="1">
        <ItemsControl ItemsSource="{Binding Snapshots}"><ItemsControl.ItemTemplate><DataTemplate>
          <StackPanel Margin="0,0,0,11"><DockPanel><TextBlock Text="●" Foreground="{Binding State, Converter={StaticResource StateColor}}" Margin="0,0,5,0"/><TextBlock Text="{Binding Provider}" FontSize="13"/></DockPanel>
          <TextBlock Text="{Binding Message}" FontSize="9" Foreground="#777780" Margin="12,2,0,0" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Message}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <ItemsControl ItemsSource="{Binding Windows}" Margin="12,5,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource MutedBrush}"/><ProgressBar Grid.Column="1" Height="4" Maximum="100" Value="{Binding RemainingPercent}" Background="#3A3A40" Foreground="#A6A6AD" Margin="0,5,8,0"/><TextBlock Grid.Column="2" Text="{Binding RemainingPercent, StringFormat={}{0:0}%}" TextAlignment="Right" FontSize="11" Foreground="#9FAFC4"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
    </Grid>
  </Border>
</Window>
